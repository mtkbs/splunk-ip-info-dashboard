| tstats summariesonly=true count from datamodel=Network_Traffic.All_Traffic where (All_Traffic.dest=XXX.XX.X.X/XX OR All_Traffic.dest=XXX.XX.X.X/XX OR All_Traffic.destXXX.XX.X.X/XX OR All_Traffic.dest=XXX.XX.X.X/XX OR All_Traffic.dest=XXX.XX.X.X/XX) by All_Traffic.src, All_Traffic.action
| rename "All_Traffic.*" as "*"
| where NOT cidrmatch("10.0.0.0/8", src) AND NOT cidrmatch("172.16.0.0/12", src) AND NOT cidrmatch("192.168.0.0/16", src) AND NOT cidrmatch("XXX.XX.X.X/XX", src) AND NOT cidrmatch(XXX.XX.X.X/XX", src) AND NOT cidrmatch("XXX.XX.X.X/XX", src) AND NOT cidrmatch("XXX.XX.X.X/XX", src) AND NOT cidrmatch("XXX.XX.X.X/XX", src)
| where src!="0.0.0.0"
| iplocation src
| where isnotnull(lat) AND isnotnull(lon)
| geostats sum(count) by action globallimit=5 binspanlat=10 binspanlong=10
